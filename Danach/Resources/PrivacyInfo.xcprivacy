<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    Datenschutz-Manifest. Apple verlangt es seit 2024 beim Upload.

	    Die App erhebt nichts, verfolgt nichts und verwendet keine der
	    begründungspflichtigen Schnittstellen. Falls später Code hinzukommt,
	    der UserDefaults, Dateizeitstempel, Systemlaufzeit oder Speicherplatz
	    ausliest, muss hier ein Eintrag unter NSPrivacyAccessedAPITypes
	    ergänzt werden – sonst lehnt App Store Connect den Upload ab.
	-->
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
